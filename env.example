# Copy to .env.local and fill in. .env.local is gitignored.

# ── Avatar ────────────────────────────────────────────────
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
NEXT_PUBLIC_TAVUS_PERSONA_ID=
# Public URL Tavus posts transcript events to. Use an ngrok tunnel
# during the hackathon: ngrok http 3001
TAVUS_CALLBACK_URL=

# ── Model ─────────────────────────────────────────────────
# Used for summaries, entity extraction, and as the custom LLM
# endpoint Tavus calls each turn.
LLM_GATEWAY_URL=https://openrouter.ai/api/v1
LLM_GATEWAY_KEY=
LLM_MODEL=anthropic/claude-haiku

# ── Embeddings ────────────────────────────────────────────
# Writes the vector column used for memory retrieval.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Postgres: relations, memories, medicines, reminders ───
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── ClickHouse: utterances, embeddings, aggregates ────────
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ── Frontend ──────────────────────────────────────────────
REACT_APP_API=http://localhost:3001
REACT_APP_LIBRECHAT_URL=http://localhost:3080

# ── Optional: tracing ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Removed from the original build: INSFORGE_*, YOU_API_KEY, TAVILY_API_KEY
