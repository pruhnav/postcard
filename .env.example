# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# ── Postgres — the curated store ──────────────────────────
# A hosted Postgres (Neon / ClickHouse Cloud managed Postgres / RDS), or
# the local one: `docker compose --profile local-pg up -d` then use
# postgresql://postcard:postcard@localhost:5433/postcard
DATABASE_URL=

# ── ClickHouse — the conversation stream + everything derived ──
# Local by default (`docker compose up -d`), browse at localhost:8123/play.
# Or a ClickHouse Cloud HTTPS endpoint (…clickhouse.cloud:8443) + password.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=postcard
CLICKHOUSE_DATABASE=default

# Everything is stored and read in her local time. Match the family below.
APP_TZ=Asia/Kolkata

# ── The family (auto-created on first server start) ───────
FAMILY_ELDER_NAME=Amama
FAMILY_SPEAKER_NAME=Ruby
FAMILY_ELDER_CITY=Chennai
FAMILY_ELDER_TZ=Asia/Kolkata
FAMILY_SPEAKER_TZ=America/Los_Angeles

# ── Model — per-turn reply, extraction, summaries ─────────
# Any OpenAI-compatible endpoint. LibreChat can reuse the same key.
#   Anthropic:   https://api.anthropic.com/v1     claude-haiku-4-5
#   OpenRouter:  https://openrouter.ai/api/v1     anthropic/claude-3.5-haiku
#   Ollama:      http://localhost:11434/v1        llama3.1:8b
LLM_GATEWAY_URL=https://api.anthropic.com/v1
LLM_GATEWAY_KEY=
LLM_MODEL=claude-haiku-4-5

# ── Embeddings — local, no key ───────────────────────────
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
REPEAT_MAX_DISTANCE=0.22

# ── Tavus — the avatar ───────────────────────────────────
TAVUS_API_KEY=
TAVUS_PERSONA_ID=
# Public URL Tavus reaches us on. Run: ngrok http 3001
TAVUS_CALLBACK_URL=

# ── Frontend ─────────────────────────────────────────────
REACT_APP_API=http://localhost:3001
REACT_APP_LIBRECHAT_URL=http://chat.localhost:3081
